# Copy to .env.local (never commit .env.local)

# --- AI insights (OpenAI-compatible API) ---
# Used by the Vite dev proxy only — the key is NOT exposed to the browser bundle.
# Restart `npm run dev` after any change to this file.
LLM_API_KEY=

# Groq (recommended for dev):
# LLM_API_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.1-8b-instant
# VITE_LLM_MODEL=llama-3.1-8b-instant

# OpenAI:
# LLM_API_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# VITE_LLM_MODEL=gpt-4o-mini

LLM_API_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.1-8b-instant

# Client-side (safe to expose) — must match provider model id above
VITE_LLM_CHAT_URL=/api/llm/chat/completions
VITE_LLM_MODEL=llama-3.1-8b-instant

# Request sizing for Groq (full journal stays in IndexedDB; only prompts are chunked)
VITE_LLM_MAX_INPUT_TOKENS=8000
VITE_LLM_CHUNK_TARGET_TOKENS=3200
VITE_LLM_SAFETY_MARGIN_TOKENS=256

# Groq TPM throttling (full history stays in IndexedDB; queue serializes API calls)
VITE_LLM_TPM_LIMIT=6000
VITE_LLM_TPM_SAFETY_RATIO=0.85
VITE_LLM_MIN_REQUEST_GAP_MS=350

# Dev only: full LLM request/response bodies append to logs/llm-traffic.log (restart npm run dev).
# LLM_TRAFFIC_LOG=logs/llm-traffic.log

# Russian journal text → English uses the LLM above (typos & medical terms).
# UI translation (EN → DE/RU) also uses the LLM when configured.
# Without LLM_API_KEY, a limited free MyMemory fallback is used (may rate-limit).

# --- Nearby doctor search (dev proxy only; key not exposed to the browser) ---
# Enable Places API (New) on your Google Cloud project, then create an API key.
# If unset, appointments search uses OpenStreetMap only.
# GOOGLE_PLACES_API_KEY=
