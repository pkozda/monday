{
  "name": "monday-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Monday - A privacy-first health platform for longitudinal medical memory",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "pr:description": "node scripts/generate-pr-description.mjs",
    "clear-journal": "node scripts/clear-journal.mjs",
    "clear-hypotheses": "node scripts/clear-hypotheses.mjs",
    "generate:favicon": "node scripts/generate-favicon.mjs",
    "setup:hooks": "git config core.hooksPath .githooks",
    "prepare": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "date-fns": "^2.30.0",
    "dexie": "^4.4.2",
    "vue": "^3.3.11",
    "vue-i18n": "^9.14.5",
    "vue-router": "^4.2.5"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^4.5.2",
    "sharp": "^0.34.5",
    "typescript": "^5.2.2",
    "vite": "^5.0.8",
    "vue-tsc": "^1.8.25"
  }
}
